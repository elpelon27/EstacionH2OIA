{
  "dashboard": {
    "title": "Valentina Bridge - Overview",
    "tags": ["estacion-h2o", "valentina", "bridge"],
    "timezone": "America/Caracas",
    "panels": [
      {
        "title": "Bridge Status",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "up{job=\"hermes\"}",
            "legendFormat": "Bridge"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 1}
              ]
            }
          }
        }
      },
      {
        "title": "Response Time P95",
        "type": "gauge",
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(valentina_response_time_seconds_bucket[5m]))",
            "legendFormat": "P95"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 5},
                {"color": "red", "value": 10}
              ]
            }
          }
        }
      },
      {
        "title": "Requests/sec (last 5m)",
        "type": "stat",
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "rate(valentina_messages_total[5m])",
            "legendFormat": "{{status}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [{"type": "value", "options": {"ok": {"color": "green"}, "error": {"color": "red"}, "duplicate": {"color": "yellow"}}}]
          }
        }
      },
      {
        "title": "Orders Confirmed",
        "type": "stat",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "increase(valentina_orders_total[24h])",
            "legendFormat": "24h"
          }
        ]
      },
      {
        "title": "Messages by Status (5m)",
        "type": "piechart",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(valentina_messages_total[5m])",
            "legendFormat": "{{status}}"
          }
        ]
      },
      {
        "title": "Response Time Histogram",
        "type": "heatmap",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(valentina_response_time_seconds_bucket[5m])",
            "format": "heatmap"
          }
        ]
      },
      {
        "title": "Dify Calls Success/Error",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(valentina_dify_calls_total[5m])",
            "legendFormat": "{{status}}"
          }
        ]
      },
      {
        "title": "Meta Send Success/Error",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(valentina_meta_send_total[5m])",
            "legendFormat": "{{status}}"
          }
        ]
      },
      {
        "title": "Dedup Hits (Meta Retries)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(valentina_dedup_hits_total[5m])",
            "legendFormat": "Dedup/sec"
          }
        ]
      },
      {
        "title": "Active Conversations (24h)",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "valentina_active_conversations",
            "legendFormat": "Active"
          }
        ]
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "30s"
  }
}

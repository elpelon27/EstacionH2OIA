# ============================================================================
# systemd unit — Valentina Bridge (OPERATIONAL — root user)
# Estación H2O · Maracaibo, Venezuela
# ============================================================================

[Unit]
Description=Valentina Bridge — FastAPI Meta Cloud API ↔ Dify (Estación H2O)
Documentation=https://github.com/elpelon27/EstacionH2OIA
After=network-online.target cloudflared.service
Wants=network-online.target cloudflared.service
StartLimitBurst=5
StartLimitIntervalSec=60
StartLimitAction=none

[Service]
Type=simple
# WatchdogSec REMOVIDO (2026-08-12): el watchdog sd_notify mataba el servicio
# con SIGABRT cada 30s aunque el bridge estaba sano. El loop asyncio que envia
# WATCHDOG=1 se quedaba sin CPU por el scan recovery/consumer (SQLite sincrono)
# y no despertaba a tiempo -> systemd lo mataba. Con Restart=always + StartLimitAction=none,
# systemd ya cubre el crash recovery sin false-positives de watchdog.
User=root
Group=root
WorkingDirectory=/mnt/ssd_trabajo/hermes-agent/api
# P1-4: ExecStartPre - validate dependencies before starting
# Fails fast if critical Python packages missing, preventing crash loop
ExecStartPre=/mnt/ssd_trabajo/hermes-agent/venv/bin/python -c "import uvicorn, fastapi, httpx, slowapi, prometheus_client, sqlite3, json, logging, os, sys; print('✅ All deps OK')"
ExecStart=/bin/bash /mnt/ssd_trabajo/hermes-agent/api/start_bridge.sh
Restart=always
RestartSec=5 10 20 30 60

# Resource limits
MemoryMax=1G
MemoryHigh=800M
MemorySwapMax=0
CPUQuota=150%
CPUAccounting=yes
MemoryAccounting=yes
IOAccounting=yes
TasksMax=512
LimitNOFILE=4096
LimitNPROC=512

OOMScoreAdjust=-100

StandardOutput=journal
StandardError=journal
SyslogIdentifier=valentina-bridge

[Install]
WantedBy=multi-user.target
# ============================================================================
# odoo-cierre-semanal.service — Cierre semanal viernes 6 PM Caracas
# ============================================================================

[Unit]
Description=Cierre semanal Odoo (viernes 6 PM Caracas)
Documentation=https://github.com/elpelon27/EstacionH2OIA
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/mnt/ssd_trabajo/hermes-agent
EnvironmentFile=/mnt/ssd_trabajo/hermes-agent/config/.env
ExecStart=/mnt/ssd_trabajo/hermes-agent/venv/bin/python /mnt/ssd_trabajo/hermes-agent/scripts/odoo_cierre_semanal.py
TimeoutSec=180
StandardOutput=journal
StandardError=journal
SyslogIdentifier=odoo-cierre-semanal

MemoryMax=512M
CPUQuota=50%
TasksMax=64
# ============================================================================
# odoo-inventario-hielo.service — Inventario hielo diario 8 AM Caracas
# ============================================================================

[Unit]
Description=Inventario de hielo Odoo (diario 8 AM Caracas)
Documentation=https://github.com/elpelon27/EstacionH2OIA
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/mnt/ssd_trabajo/hermes-agent
EnvironmentFile=/mnt/ssd_trabajo/hermes-agent/config/.env
ExecStart=/mnt/ssd_trabajo/hermes-agent/venv/bin/python /mnt/ssd_trabajo/hermes-agent/scripts/odoo_inventario_hielo.py
TimeoutSec=120
StandardOutput=journal
StandardError=journal
SyslogIdentifier=odoo-inventario-hielo

MemoryMax=512M
CPUQuota=50%
TasksMax=64
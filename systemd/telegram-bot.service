# ============================================================================
# systemd unit — Telegram Bot Kill Switch + Alerts (OPERATIONAL — root, sin watchdog)
# Estación H2O · Maracaibo, Venezuela
# ============================================================================

[Unit]
Description=Telegram Bot — Kill Switch + Alerts para Valentina Bridge
After=network-online.target valentina-bridge.service
Wants=network-online.target valentina-bridge.service
StartLimitBurst=5
StartLimitIntervalSec=60
StartLimitAction=none

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/mnt/ssd_trabajo/hermes-agent/skills
ExecStart=/bin/bash /mnt/ssd_trabajo/hermes-agent/start_telegram.sh
Restart=always
RestartSec=10 20 30 60 120

# Resource limits
MemoryMax=256M
MemoryHigh=200M
MemorySwapMax=0
CPUQuota=50%
CPUAccounting=yes
MemoryAccounting=yes
IOAccounting=yes
TasksMax=50
LimitNOFILE=4096
LimitNPROC=50

OOMScoreAdjust=-100

StandardOutput=journal
StandardError=journal
SyslogIdentifier=telegram-bot

[Install]
WantedBy=multi-user.target
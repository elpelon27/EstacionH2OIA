# ============================================================================
# systemd unit — Valentina Bridge (HARDENED — referencia para futura activación)
# Estación H2O · Maracaibo, Venezuela
# ============================================================================
# NOTA: Esta versión incluye hardening completo (ProtectSystem=strict, SystemCallFilter, etc.)
# Requiere que el usuario skynet tenga límites de procesos suficientes (TasksMax=infinity en user slice)
# Actualmente deshabilitada porque rompe el arranque en este sistema.
# Versión operativa: valentina-bridge.service (User=root)
# ============================================================================

[Unit]
Description=Valentina Bridge — FastAPI Meta Cloud API ↔ Dify (Estación H2O)
Documentation=https://github.com/elpelon27/EstacionH2OIA
After=network-online.target cloudflared.service
Wants=network-online.target cloudflared.service
StartLimitBurst=5
StartLimitIntervalSec=60
StartLimitAction=none

[Service]
Type=simple
User=skynet
Group=skynet
WorkingDirectory=/mnt/ssd_trabajo/hermes-agent/api
ExecStart=/bin/bash /mnt/ssd_trabajo/hermes-agent/api/start_bridge.sh
Restart=always
RestartSec=5 10 20 30 60
WatchdogSec=30

# Hardening completo
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/ssd_trabajo/hermes-agent/data /mnt/ssd_trabajo/hermes-agent/logs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Resource limits
MemoryMax=1G
MemoryHigh=800M
MemorySwapMax=0
CPUQuota=150%
CPUAccounting=yes
MemoryAccounting=yes
IOAccounting=yes
TasksMax=512
LimitNOFILE=4096
LimitNPROC=512

OOMScoreAdjust=-100

StandardOutput=journal
StandardError=journal
SyslogIdentifier=valentina-bridge

[Install]
WantedBy=multi-user.target
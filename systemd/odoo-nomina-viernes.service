# ============================================================================
# odoo-nomina-viernes.service — Nómina viernes 5 PM Caracas
# ============================================================================

[Unit]
Description=Nómina viernes Odoo (viernes 5 PM Caracas)
Documentation=https://github.com/elpelon27/EstacionH2OIA
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/mnt/ssd_trabajo/hermes-agent
EnvironmentFile=/mnt/ssd_trabajo/hermes-agent/config/.env
ExecStart=/mnt/ssd_trabajo/hermes-agent/venv/bin/python /mnt/ssd_trabajo/hermes-agent/scripts/odoo_nomina_viernes.py
TimeoutSec=120
StandardOutput=journal
StandardError=journal
SyslogIdentifier=odoo-nomina-viernes

MemoryMax=512M
CPUQuota=50%
TasksMax=64
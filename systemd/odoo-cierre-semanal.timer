# ============================================================================
# odoo-cierre-semanal.timer — Viernes 6:00 PM Caracas (UTC-4) = 22:00 UTC
# ============================================================================

[Unit]
Description=Timer para cierre semanal Odoo (viernes 6 PM Caracas)

[Timer]
OnCalendar=Fri *-*-* 22:00 UTC
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
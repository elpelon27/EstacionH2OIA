# ============================================================================
# systemd unit — Telegram Bot Kill Switch + Alerts (OPERATIONAL — 작동 검증됨)
# Estación H2O · Maracaibo, Venezuela
# ============================================================================

[Unit]
Description=Telegram Bot — Kill Switch + Alerts para Valentina Bridge
After=network-online.target valentina-bridge.service
Wants=network-online.target valentina-bridge.service
StartLimitBurst=5
StartLimitIntervalSec=60
StartLimitAction=none

[Service]
Type=simple
User=skynet
Group=skynet
WorkingDirectory=/mnt/ssd_trabajo/hermes-agent/skills
EnvironmentFile=/mnt/ssd_trabajo/hermes-agent/config/.env
ExecStart=/mnt/ssd_trabajo/hermes-agent/venv/bin/python telegram_bot.py
Restart=always
RestartSec=10 20 30 60 120
WatchdogSec=60

# Resource limits
MemoryMax=256M
MemoryHigh=200M
MemorySwapMax=0
CPUQuota=50%
CPUAccounting=yes
MemoryAccounting=yes
IOAccounting=yes
TasksMax=50
LimitNOFILE=4096
LimitNPROC=50

OOMScoreAdjust=-100

StandardOutput=journal
StandardError=journal
SyslogIdentifier=telegram-bot

[Install]
WantedBy=multi-user.target
# ============================================================================
# odoo-inventario-hielo.timer — 8:00 AM Caracas (UTC-4) = 12:00 UTC
# ============================================================================

[Unit]
Description=Timer para inventario hielo Odoo (8 AM Caracas)

[Timer]
OnCalendar=*-*-* 12:00 UTC
Persistent=true
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
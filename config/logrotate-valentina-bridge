# /etc/logrotate.d/valentina-bridge
# Log rotation for valentina-bridge application logs
# If the app writes to files (not just journald)

/mnt/ssd_trabajo/hermes-agent/logs/*.log {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    create 0640 skynet valentina
    sharedscripts
    postrotate
        systemctl reload valentina-bridge > /dev/null 2>&1 || true
    endscript
}


# ===== HERMES AGENT — VARIABLES DE ENTORNO =====
# NUNCA commitear este archivo (está en .gitignore)
# Permisos: chmod 600

# === IDENTIDAD ===
PROJECT_NAME=HermesAgent
ENVIRONMENT=production
LOG_LEVEL=INFO
TZ=America/Caracas

# === OPENROUTER (Cloud IA — Fusion Tournament) ===
OPENROUTER_API_KEY=sk-or-v1-REEMPLAZAR
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=z-ai/glm-4.5
OPENROUTER_FUSION_MODELS=z-ai/glm-4.5,anthropic/claude-sonnet-4.5,deepseek/deepseek-chat-v3.2,google/gemini-2.5-flash
OPENROUTER_JUDGE_MODEL=z-ai/glm-4.5
OPENROUTER_SITE_URL=https://github.com/elpelon27/EstacionH2OIA
OPENROUTER_APP_NAME=HermesAgent
OPENROUTER_DAILY_ALERT_USD=5.00
OPENROUTER_DAILY_BLOCK_USD=15.00

# === OLLAMA (Local IA) ===
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=30

# === TELEGRAM BOT #1 — Operaciones H2O (clientes + alertas) ===
TELEGRAM_BOT_TOKEN_H2O=REEMPLAZAR_TOKEN_BOT_H2O
TELEGRAM_CHAT_ID_LIDER=REEMPLAZAR_CHAT_ID

# === TELEGRAM BOT #2 — Hermes (Líder ↔ IA desarrollo) ===
TELEGRAM_BOT_TOKEN_HERMES=REEMPLAZAR_TOKEN_BOT_HERMES
TELEGRAM_CHAT_ID_HERMES=REEMPLAZAR_CHAT_ID

# === WHATSAPP (WAHA — instalar en BLOQUE 10.10) ===
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=REEMPLAZAR
WAHA_WEBHOOK_SECRET=REEMPLAZAR
WAHA_SESSION_ID=estacionh2o_main
WHATSAPP_PHONE=584122560721

# === GITHUB ===
GITHUB_REPO=elpelon27/EstacionH2OIA
GITHUB_DEFAULT_BRANCH=main

# === QDRANT (instalar en BLOQUE 10.7) ===
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=REEMPLAZAR
QDRANT_COLLECTION=hermes_memory

# === DATABASE ===
DATABASE_URL=sqlite+aiosqlite:////mnt/ssd_trabajo/sqlite/hermes.db
DATABASE_BACKUP_PATH=/mnt/ssd_trabajo/backups/daily

# === UMBRALES NEGOCIO ===
SUSPICIOUS_PAYMENT_THRESHOLD_USD=100.00
RATE_LIMIT_CLIENT_PER_MIN=30
RATE_LIMIT_CLIENT_PER_DAY=100
RATE_LIMIT_IP_PER_MIN=100
RATE_LIMIT_LLM_PER_AGENT_PER_MIN=60

# === OPERACIÓN ===
OPERATION_CENTER_LAT=10.6447
OPERATION_CENTER_LON=-71.6101
OPERATION_RADIUS_KM=10
WORKING_HOURS_START=08:30
WORKING_HOURS_END=17:00

# === FUSION ===
FUSION_MIN_SCORE=7.0
FUSION_TIMEOUT_SEC=30
FUSION_PARALLEL=true

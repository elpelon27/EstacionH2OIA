# ============================================================================
# .env.example — Estación H2O · Valentina Bridge
# Plantilla de configuración. Copiar a config/.env y rellenar con valores reales.
# NUNCA commitear config/.env (ya está en .gitignore).
# ============================================================================

# --- Meta Cloud API (WhatsApp Business) ---
META_ACCESS_TOKEN=your-meta-access-token-here
META_PHONE_NUMBER_ID=your-phone-number-id-here
META_APP_SECRET=your-app-secret-here
META_VERIFY_TOKEN=your-verify-token-here
META_API_VERSION=v25.0

# --- Dify (LLM orchestrator para Valentina) ---
DIFY_API_URL=http://localhost/v1/chat-messages
DIFY_API_KEY=your-dify-api-key-here

# --- Bridge (FastAPI server) ---
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8000
BRIDGE_LOG_LEVEL=INFO
BRIDGE_HEALTH_URL=http://localhost:8000/health
BRIDGE_ALLOW_INSECURE_SALT=  # dejar vacío en producción; set para dev solo

# --- Rate limiting ---
RATE_LIMIT_PER_PHONE=30
RATE_LIMIT_PER_IP=100

# --- SQLite ---
SQLITE_PATH=/mnt/ssd_trabajo/hermes-agent/data/conversations.db
DISPATCH_DB_PATH=/mnt/ssd_trabajo/hermes-agent/data/dispatch.db

# --- Security ---
LOG_SALT=change-this-in-production

# --- Telegram: Bot de alertas/kill-switch ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here
KILL_SWITCH_FILE=/mnt/ssd_trabajo/hermes-agent/data/kill_switch.flag

# --- Telegram: Bot del Líder (Prometeo) ---
TELEGRAM_BOT_TOKEN_HERMES=your-hermes-bot-token-here
TELEGRAM_CHAT_ID_HERMES=your-hermes-chat-id-here

# --- Telegram: Bot choferes (Dispatcher) ---
DISPATCHER_BOT_TOKEN=your-dispatcher-bot-token-here
TELEGRAM_DISPATCH_CHAT=your-dispatch-chat-id-here

# --- Google Sheets ---
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here
GOOGLE_CREDENTIALS_PATH=/mnt/ssd_trabajo/hermes-agent/config/google_credentials.json
GOOGLE_SHEET_NAME=Pedidos
GOOGLE_SHEETS_ENABLED=true
PII_SAFE=true

# --- Horario laboral (guard determinístico) ---
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=18
BUSINESS_HOURS_DAYS=1-6  # Lunes a Sábado

# --- Financial Shield ---
FS_MONEDA_BASE=EUR
FS_MONEDA_LOCAL=VES
FS_MONEDA_REFERENCIA=USD
FS_COMISION_BOTELLON_EUR=2.50
FS_MAX_RECORDATORIOS=3
FS_INTERVALO_RECORDATORIO_MINUTOS=60
FS_BUFFER_REPORTE_MINUTOS=5
FS_HORA_REPORTE=18:30
FS_TASA_API_URL=https://open.er-api.com/v6/latest/EUR
FS_TASA_FALLBACK_BCV=true
FS_BANK_VERIFICATION_METHOD=manual
FS_OCR_ENABLED=false
FS_LLM_VRAM_LIMIT_MB=3500

# --- Odoo 17 ---
ODOO_URL=http://localhost:8069
ODOO_DB=odoo_h2o
ODOO_USERNAME=admin
ODOO_PASSWORD=your-odoo-password-here
ODOO_API_KEY=your-odoo-api-key-here

# --- R4 Conecta (Banco) ---
R4_BASE_URL=https://r4conecta.mibanco.com.ve
R4_WEBHOOK_AUTH_TOKEN=your-r4-webhook-auth-token-here
R4_WEBHOOK_ALLOWED_IPS=190.x.x.x,200.x.x.x
R4_COMMERCE_ID=your-commerce-id-here
R4_COMMERCE_SECRET=your-commerce-secret-here
R4_COMMERCE_TOKEN=  # DEPRECATED — mantener vacío
R4_ID_COMERCIO=your-r4-id-comercio-here
R4_TELEFONO_COMERCIO=+58XXXXXXXXXX
R4_WEBHOOK_RATE_LIMIT=100
R4_WEBHOOK_RATE_WINDOW=60
R4_MAX_RETRIES=3
R4_RETRY_DELAY=1.0
R4_TIMEOUT=30

# --- Ollama (embeddings + LLM local) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Cadena de fallback LLM ---
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL_PAID=z-ai/glm-5.3
OPENROUTER_MODEL_FREE=z-ai/glm-5.2:free
OLLAMA_MODEL=qwen2.5:7b
LLM_TIMEOUT=60

# --- NVIDIA NIM (Prometeo CLI) ---
NVIDIA_API_KEY=your-nvidia-api-key-here

# --- mem0 ---
MEM0_API_KEY=  # dejar vacío si se usa mem0 local sin API remota

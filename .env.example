# Secrets del proyecto — copiar a .env y llenar valores reales. NUNCA commitear .env

# ── Meta WhatsApp Cloud API (envío de mensajes — Graph API directa) ──
# Token de system user (permanente, Business Manager) o temporary (24h) del
# dashboard: App > WhatsApp > Configuration. Ver docs/META_MCP_DESIGN.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_ID=1186108677920030

# NOTA: el Meta Devtools MCP (https://mcp.facebook.com/devtools) NO usa
# client_id/secret propios — su OAuth es con cuenta Meta developer vía
# `hermes mcp login meta_devtools`. Los tokens OAuth los persiste Hermes.
# Config del server MCP en config.yaml (mcp_servers.meta_devtools), no aquí.
# --- POD Digital (Bloques 2-5, 2026-09-27) ---
POD_VEHICLE_TOKEN=h2o-pod-2026-veh1     # token único (todos los vehículos)
POD_VEHICLE_TOKENS=token1:1,token2:2    # alternativa: mapa token:vehicle (kill-switch granular)
POD_CHOFER_PIN=1379                      # PIN PWA chofer (CAMBIAR en producción)
POD_SIGN_URL=http://valentina.estacionh2o.com:8000/pod
POD_PHOTO_DIR=/mnt/ssd_trabajo/hermes-agent/data/pod_photos
POD_HTML_PATH=/mnt/ssd_trabajo/hermes-agent/web/pod_form.html
POD_PRECIO_AGUA=1.00
POD_PRECIO_HIELO=1.20
POD_REVOKED_FILE=/mnt/ssd_trabajo/hermes-agent/data/pod_revoked.json
TELEGRAM_ALERT_CHAT=                    # chat del operador para alertas PIN bloqueado
TELEGRAM_ALERT_TOKEN=                   # bot token para alertas

# --- Odoo (credenciales reales en infra/odoo/.env) ---
ODOO_URL=http://localhost:8069
ODOO_DB=estacion_h2o
ODOO_USERNAME=admin
ODOO_PASSWORD=

# --- WAHA / OSRM (logística last-mile) ---
WAHA_API_KEY=
OSRM_URL=http://localhost:5000
